# ---------------------------------------------------------------------------
# My Kitchen — one file for development (pnpm dev) and Docker deployment.
# `./deploy.sh` creates this file for you with generated secrets.
# ---------------------------------------------------------------------------

# ----- Self-hosting (Docker) -------------------------------------------------
# Host port and bind address for the app container.
#   APP_BIND=127.0.0.1  only this machine (put a tunnel/reverse proxy in front)
#   APP_BIND=0.0.0.0    reachable from your LAN
APP_PORT=3003
APP_BIND=127.0.0.1

# Public URL users type, scheme included. Must match exactly or form posts fail (CSRF).
# Examples: http://localhost:3003, http://192.168.1.20:8080, https://kitchen.example.com
# Leave EMPTY only when using the Cloudflare quick tunnel (random hostname).
ORIGIN=http://localhost:3003

# Your own account. Created on the first start if it does not exist yet; afterwards these
# lines are ignored (change name/password under Settings). Password: 8 to 128 characters.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Cloudflare Tunnel (optional). Pick one profile or leave empty for no tunnel:
#   COMPOSE_PROFILES=tunnel        + CLOUDFLARE_TUNNEL_TOKEN (named tunnel, your domain, ORIGIN=https://your-host)
#   COMPOSE_PROFILES=quicktunnel   zero-config try-out URL (ORIGIN empty)
COMPOSE_PROFILES=
CLOUDFLARE_TUNNEL_TOKEN=

# Bundled PostgreSQL (compose.yaml)
POSTGRES_USER=recipe
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=recipe

# Better Auth secret: at least 32 random characters (openssl rand -base64 48)
BETTER_AUTH_SECRET=

# Allow anyone who reaches the site to create an account. With false, accounts can only be
# created through the ADMIN_* lines above or a household invitation link (Household → Invite).
REGISTRATION_OPEN=true

# ----- Database connection used by pnpm dev / scripts / compose.cloud-db.yaml -----
DATABASE_URL=postgres://recipe:recipe@127.0.0.1:5433/recipe_dev
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_IDLE_TIMEOUT_SECONDS=30
# "require" for cloud databases with TLS; empty to disable; "no-verify" for self-signed.
DATABASE_SSL=

# ----- Images -----------------------------------------------------------------
STORAGE_BACKEND=local
UPLOAD_DIR=./data/uploads
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
UPLOAD_MAX_BYTES=5242880
BODY_SIZE_LIMIT=6M
IMAGE_CONCURRENCY=2

# ----- Social sign-in (all optional) ------------------------------------------
# Each provider appears on the sign-in page only when its two values are set, so
# leaving this whole block empty keeps password-only sign-in exactly as it was.
# Every provider needs this exact redirect URI registered with it:
#   <ORIGIN>/api/auth/callback/<provider>
# e.g. https://kitchen.example.com/api/auth/callback/google
#
# Google: console.cloud.google.com -> APIs & Services -> Credentials ->
#         OAuth client ID -> Web application.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft: entra.microsoft.com -> App registrations. Leave the tenant as
# "common" to accept personal Outlook/Hotmail accounts as well as work ones.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
# Apple: needs a paid Apple Developer Program membership. APPLE_CLIENT_ID is the
# Services ID, not the app bundle id. The secret is a JWT you sign with the .p8
# key, and Apple rejects one older than six months, so it must be regenerated.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=

# ----- Misc -------------------------------------------------------------------
# How often visible pantry/shopping screens poll for household changes (ms).
PUBLIC_REVISION_POLL_MS=20000
