# ---------------------------------------------------------------------------
# Pantry & Plate — environment (copy to .env for local development,
# and provide the same variables to Docker Compose for production)
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Changing this must never require code changes.
# Local development (compose.dev.yaml):
DATABASE_URL=postgres://recipe:recipe@127.0.0.1:5433/recipe_dev
# Production with the bundled db service (compose.yaml) uses the POSTGRES_* values below.
POSTGRES_USER=recipe
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=recipe

# Pool sizing. Total connections across all app instances must fit the server.
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_IDLE_TIMEOUT_SECONDS=30
# Set to "require" when your cloud database mandates TLS (e.g. Neon, Supabase, RDS).
DATABASE_SSL=

# Public origin of the site, including scheme. Used for auth cookies, CSRF and
# trusted origins. Production example: https://pantry.example.com
ORIGIN=http://localhost:5173

# Better Auth secret: at least 32 random characters. Generate with
#   openssl rand -base64 48
BETTER_AUTH_SECRET=

# Allow new accounts to register themselves. Set to "false" for a private
# household deployment after the first accounts exist (invites still work).
REGISTRATION_OPEN=true

# Image storage backend: "local" (persistent volume) or "s3".
STORAGE_BACKEND=local
# Local backend: directory for uploads (mounted as a volume in Docker).
UPLOAD_DIR=./data/uploads
# S3 backend (only read when STORAGE_BACKEND=s3). Bucket must be private.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Upload limits. BODY_SIZE_LIMIT is read by adapter-node; keep it above
# UPLOAD_MAX_BYTES so multipart bodies are not rejected before validation.
UPLOAD_MAX_BYTES=5242880
BODY_SIZE_LIMIT=6M
IMAGE_CONCURRENCY=2

# How often visible pantry/shopping screens poll for household changes (ms).
PUBLIC_REVISION_POLL_MS=20000

# Node runtime (adapter-node)
HOST=0.0.0.0
PORT=3000

# Cloudflare Tunnel token (compose.yaml, cloudflared service)
CLOUDFLARE_TUNNEL_TOKEN=
