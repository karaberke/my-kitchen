{
	"name": "recipe-saver",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "pnpm test:unit && pnpm test:integration",
		"test:unit": "vitest run --project unit",
		"test:integration": "vitest run --project integration",
		"test:e2e": "playwright test",
		"db:dev": "docker compose -f compose.dev.yaml -p recipe-saver-dev up -d",
		"db:dev:down": "docker compose -f compose.dev.yaml -p recipe-saver-dev down",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node --env-file=.env scripts/migrate.mjs",
		"db:migrate:test": "node --env-file=.env.test scripts/migrate.mjs",
		"db:studio": "drizzle-kit studio",
		"db:check": "node --env-file=.env scripts/consistency-check.mjs",
		"seed:perf": "node --env-file=.env scripts/seed-perf.mjs",
		"measure": "node --env-file=.env scripts/measure.mjs",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "1.63.0",
		"@sveltejs/adapter-node": "5.5.7",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "^24",
		"auth": "^1.6.23",
		"better-auth": "1.7.3",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"postgres": "^3.4.9",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "5.57.0",
		"svelte-check": "^4.6.0",
		"tailwindcss": "4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "8.2.2",
		"vitest": "5.0.0"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "3.1128.0",
		"sharp": "0.35.4",
		"zod": "4.5.4"
	},
	"engines": {
		"node": ">=24 <27",
		"pnpm": ">=10"
	},
	"packageManager": "pnpm@12.3.4"
}
