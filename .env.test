DATABASE_URL=postgres://recipe:recipe@127.0.0.1:5433/recipe_test
ORIGIN=http://localhost:4173
BETTER_AUTH_SECRET=test-only-secret-0123456789abcdef0123456789
REGISTRATION_OPEN=true
STORAGE_BACKEND=local
UPLOAD_DIR=./data/test-uploads
UPLOAD_MAX_BYTES=5242880
PUBLIC_REVISION_POLL_MS=2000
AUTH_RATE_LIMIT_FACTOR=20

# Barcode lookups happen in the app process, so a browser-side mock cannot
# reach them. The tests point USDA at a stub they start themselves and leave
# Open Food Facts switched off, which also keeps the suite off the real
# internet.
USDA_API_KEY=e2e-test-key
USDA_BASE_URL=http://127.0.0.1:4319
OFF_ENABLED=false
